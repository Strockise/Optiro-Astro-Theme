---
import config from '../config/config.json';
import SeoMeta from '../components/SeoMeta.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page id – the animations bundled in /js/interactions.js are keyed by it. */
  pageId: string;
  title?: string;
  rawTitle?: boolean;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * `default`: navbar + <div class="main"> + footer.
   * `utility`: the 404 layout (navbar + centered content, no footer).
   */
  layout?: 'default' | 'utility';
  /** Spacer under the fixed navbar. The home page hero sits under the navbar instead. */
  navbarSpacer?: boolean;
}

const { pageId, title, rawTitle, description, image, type, noindex, layout = 'default', navbarSpacer = true } = Astro.props;
const { siteId } = config.interactions;
---

<!doctype html>
<html data-wf-page={pageId} data-wf-site={siteId} lang={config.site.language}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta title={title} rawTitle={rawTitle} description={description} image={image} type={type} noindex={noindex} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/base.css" rel="stylesheet" type="text/css" />
    <link href="/css/optiro.css" rel="stylesheet" type="text/css" />
    <style is:inline>html.w-mod-js:not(.w-mod-ix3) :is(.display-header, .section-header) {visibility: hidden !important;}</style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">WebFont.load({ google: { families: ['Geist:300,400,500,600,700'] } });</script>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />
    <slot name="head" />
  </head>
  <body>
    {
      layout === 'default' && (
        <div class="page-wrapper">
          <Navbar />
          {navbarSpacer && <div class="navbar-spcaer" />}
          <div class="main">
            <slot />
          </div>
          <Footer />
        </div>
      )
    }
    {
      layout === 'utility' && (
        <div class="utility-page-wrap">
          <Navbar />
          <slot />
          <div class="section-glow">
            <div class="primary-glow" />
          </div>
        </div>
      )
    }
    <script is:inline src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/js/interactions.js" type="text/javascript"></script>
    <script is:inline src="/js/gsap.min.js" type="text/javascript"></script>
    <script is:inline src="/js/SplitText.min.js" type="text/javascript"></script>
    <script is:inline src="/js/ScrollTrigger.min.js" type="text/javascript"></script>
    <slot name="scripts" />
  </body>
</html>
