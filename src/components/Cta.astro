---
import PrimaryButton from './PrimaryButton.astro';
---

<section class="cta-section">
  <div class="w-layout-blockcontainer main-container w-container">
    <div data-w-id="a02a95a6-a16a-e47b-bdeb-705b9e5c1bcb" class="cta-block">
      <div class="cta-glow"></div>
      <div class="cta-block-content">
        <div class="section-header-block width-405px">
          <div class="header-block">
            <h2>Hire your first AI agent today</h2>
          </div>
          <div class="summery-block top-12px">
            <p class="body-text-default">Stop wasting hours on repetitive tasks. With Optiro, your website can showcase AI agents that work smarter, faster, and around the clock.</p>
          </div>
          <div class="button-block top-56px">
            <PrimaryButton href="/contact" label="Get started free" />
          </div>
        </div>
        <div class="cta-asset-block"><img src="/images/CTA-Phone-Image.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227847-p-500.webp 500w, /images/Frame-2147227847-p-800.webp 800w, /images/Frame-2147227847-p-1080.webp 1080w, /images/Frame-2147227847-p-1600.webp 1600w, /images/Frame-2147227847-p-2000.webp 2000w, /images/CTA-Phone-Image.webp 2014w" alt="CTA Asset" class="cta-asset"></div>
      </div>
    </div>
  </div>
</section>
