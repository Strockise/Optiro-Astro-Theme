<section class="faq-section">
  <div class="w-layout-blockcontainer main-container w-container">
    <div class="faq-content-block">
      <div class="section-header-block width-380px">
        <div class="section-tag-block">
          <div class="tag-circle"></div>
          <div class="tag-text">FAQ</div>
        </div>
        <div class="header-block">
          <h2 class="section-header">Frequently asked questions</h2>
        </div>
      </div>
      <div class="faq-block">
        <div data-delay="0" data-hover="false" class="faq-item-block w-dropdown">
          <div class="faq-toggle w-dropdown-toggle">
            <div class="faq-text">What is Optiro?</div>
            <div class="faq-arrow-block">
              <div class="arrow w-embed"><svg width="100%" height="100%" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L6.72387 6.72387C7.16827 7.16827 7.39053 7.39053 7.66667 7.39053C7.9428 7.39053 8.16507 7.16827 8.60947 6.72387L14.3333 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
          </div>
          <nav class="faq-dropdown-block w-dropdown-list">
            <div class="faq-drodown-content">
              <div class="faq-summery-block">
                <p class="body-text-default">Optiro is a sales management SaaS platform designed to help teams track leads, manage pipelines, and close deals more efficiently.</p>
              </div>
            </div>
          </nav>
