---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
---

<BaseLayout pageId="6ac8861e88e22add894545b8" title="Feature">
  <section class="feature-main-section">
    <div class="w-layout-blockcontainer main-container less-width w-container">
      <div class="feature-content-block">
        <div class="section-header-block flex-verticle-center">
          <div class="header-block width-580px">
            <h1 class="display-header">Features that bring AI agents to life</h1>
          </div>
          <div data-w-id="de933fa3-58c5-4ae9-f47f-3572cf184dd3" style="-webkit-transform:translate3d(0, 20%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 20%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 20%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 20%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="summery-block top-16px width-580px">
            <p class="body-text-default">Optiro isn’t just automation. It’s a new kind of intelligence that adapts, learns, and acts like a true digital teammate.</p>
          </div>
        </div>
      </div>
      <div class="process-cards-content">
        <div class="process-card-block">
          <div class="process-card-content">
            <div class="process-card-main-content">
              <div class="process-card-tag-block">
                <div class="body-text-default opacity-100">01</div>
              </div>
              <div class="process-card-text-content">
                <div class="header-block">
                  <h2 class="card-header">Adaptive intelligence</h2>
                </div>
                <div class="summery-block">
                  <p class="body-text-default">Every interaction makes Optiro smarter. Your agent adapts to your workflows, context, and style just like a human teammate.</p>
                </div>
              </div>
            </div>
            <div class="process-card-image-block"><img src="/images/Frame-2147227791.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 727.984375px, 939.984375px" srcset="/images/Frame-2147227791-p-500.webp 500w, /images/Frame-2147227791-p-800.webp 800w, /images/Frame-2147227791.webp 970w" alt="Process Card Image" class="process-card-image"></div>
          </div>
        </div>
        <div class="process-card-block">
          <div class="process-card-content">
            <div class="process-card-main-content">
              <div class="process-card-tag-block">
                <div class="body-text-default opacity-100">02</div>
              </div>
              <div class="process-card-text-content">
                <div class="header-block">
                  <h3 class="card-header">Multi-tool mastery</h3>
                </div>
                <div class="summery-block">
                  <p class="body-text-default">From slack to notion, zapier to google workspace, optiro plugs into your favorite tools and unifies them into one intelligent system.</p>
                </div>
              </div>
            </div>
            <div class="process-card-image-block"><img src="/images/Frame-2147227794.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 727.984375px, 939.984375px" srcset="/images/Frame-2147227794-p-500.webp 500w, /images/Frame-2147227794-p-800.webp 800w, /images/Frame-2147227794.webp 970w" alt="Process Card Image" class="process-card-image"></div>
          </div>
        </div>
        <div class="process-card-block">
          <div class="process-card-content">
            <div class="process-card-main-content">
              <div class="process-card-tag-block">
                <div class="body-text-default opacity-100">03</div>
              </div>
              <div class="process-card-text-content">
                <div class="header-block">
                  <h3 class="card-header">Autonomous execution</h3>
                </div>
                <div class="summery-block">
                  <p class="body-text-default">Assign tasks and let your agent execute them independently, whether it’s data gathering, task management, or client support.</p>
                </div>
              </div>
            </div>
            <div class="process-card-image-block"><img src="/images/Frame-2147227790.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 727.984375px, 939.984375px" srcset="/images/Frame-2147227790-p-500.webp 500w, /images/Frame-2147227790-p-800.webp 800w, /images/Frame-2147227790.webp 970w" alt="Process Card Image" class="process-card-image"></div>
          </div>
        </div>
        <div class="process-card-block">
          <div class="process-card-content">
            <div class="process-card-main-content">
              <div class="process-card-tag-block">
                <div class="body-text-default opacity-100">04</div>
              </div>
              <div class="process-card-text-content">
                <div class="header-block">
                  <h3 class="card-header">Transparent insights</h3>
                </div>
                <div class="summery-block">
                  <p class="body-text-default">Track what your agents are doing and why. Get detailed reports, performance metrics, and decision transparency.</p>
                </div>
              </div>
            </div>
            <div class="process-card-image-block"><img src="/images/Frame-2147227790-1.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 727.984375px, 939.984375px" srcset="/images/Frame-2147227790-1-p-500.webp 500w, /images/Frame-2147227790-1-p-800.webp 800w, /images/Frame-2147227790-1.webp 970w" alt="Process Card Image" class="process-card-image"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="section-glow">
      <div class="primary-glow"></div>
    </div>
  </section>
  <Cta />
</BaseLayout>
