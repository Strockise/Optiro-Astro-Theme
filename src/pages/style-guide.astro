---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
---

<BaseLayout pageId="6ac8861e88e22add894545b7" title="Style Guide">
  <section class="style-guide-section">
    <div class="section-glow">
      <div class="primary-glow"></div>
    </div>
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="style-guide-content-block relative">
        <div class="style-guide-header-block flex-verticle-center">
          <div class="header-block">
            <h1 class="display-header">Style guide</h1>
          </div>
          <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf97491" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="summery-block top-20px width-730px">
            <p class="body-text-default opacity-70">Explore the nuanced realm of typography, uncovering the ideal harmony between readability and style</p>
          </div>
        </div>
        <div class="style-guide-colors">
          <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf97495" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="header-block">
            <h2 class="section-header">Colors</h2>
          </div>
          <div class="style-guide-liner"></div>
          <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf97499" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="style-guide-colors-grid">
            <div class="style-guide-color-item brand-color">
              <div class="color-style-text">#45D57E</div>
            </div>
            <div class="style-guide-color-item secondary-color">
              <div class="color-style-text">#F0F0F0</div>
            </div>
            <div class="style-guide-color-item white-color">
              <div class="color-style-text">#FFFFFF</div>
            </div>
            <div class="style-guide-color-item bg-color">
              <div class="color-style-text">#070F0F</div>
            </div>
            <div class="style-guide-color-item brand-black-color">
              <div class="color-style-text">#000800</div>
            </div>
          </div>
        </div>
        <div class="style-guide-typography">
          <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf974ad" style="opacity:0;-webkit-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="header-block">
            <h2 class="section-header">Typography</h2>
          </div>
          <div class="style-guide-liner"></div>
          <div class="style-guide-typography-main">
            <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf974b2" class="style-guide-typography-item">
              <div class="style-guide-typography-preview">
                <h1>Heading 1</h1>
              </div>
              <div class="style-guide-typography-info">
                <div class="style-guide-info-text">Geist \ Semibold</div>
                <div class="style-guide-info-text">100px / 110%</div>
              </div>
            </div>
            <div class="style-guide-typography-item">
              <div class="style-guide-typography-preview">
                <h2>Heading 2</h2>
              </div>
              <div class="style-guide-typography-info">
                <div class="style-guide-info-text">Geist \ Semibold</div>
                <div class="style-guide-info-text">56px / 110%</div>
              </div>
            </div>
            <div class="style-guide-typography-item">
              <div class="style-guide-typography-preview">
                <h3>Heading 3</h3>
              </div>
              <div class="style-guide-typography-info">
                <div class="style-guide-info-text">Geist \ Regular</div>
                <div class="style-guide-info-text">40px / 110%</div>
              </div>
            </div>
            <div class="style-guide-typography-item">
              <div class="style-guide-typography-preview">
                <h4>Heading 4</h4>
              </div>
              <div class="style-guide-typography-info">
                <div class="style-guide-info-text">Geist \ Medium</div>
                <div class="style-guide-info-text">32px / 100%</div>
              </div>
            </div>
            <div class="style-guide-typography-item">
              <div class="style-guide-typography-preview">
                <p class="body-text-default opacity-100">Body 1</p>
              </div>
              <div class="style-guide-typography-info">
                <div class="style-guide-info-text">Geist \ Regular</div>
                <div class="style-guide-info-text">20px / 120%</div>
              </div>
            </div>
          </div>
          <div class="style-guide-liner"></div>
          <div data-w-id="953f6449-1a80-9ed2-3b42-086fbaf974e0" class="style-guide-utility">
            <div class="style-info-header">
              <h2 class="display-header">Buttons</h2>
            </div>
            <div class="style-preview-block">
              <div class="primary-button">
                <div class="button-text">Sign up</div>
              </div>
            </div>
          </div>
          <div class="style-guide-liner"></div>
          <div class="style-guide-utility">
            <div class="style-info-header">
              <h2 class="display-header">Icon</h2>
            </div>
            <div class="style-icons-preview-grid">
              <div class="style-icons-block"><img loading="lazy" src="/images/Group-1261155294.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/Frame.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/Frame-1.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/instagram.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/Frame-2.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/Frame-3.svg" alt="Style Icon" class="style-icon"></div>
              <div class="style-icons-block"><img loading="lazy" src="/images/in.svg" alt="Style Icon" class="style-icon"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Cta />
</BaseLayout>
